FROM ros:humble-ros-base

ENV ROS_DISTRO=humble
WORKDIR /ros2_ws

RUN apt-get update && apt-get install -y ros-humble-teleop-twist-keyboard

# Копируем скрипт точки входа
COPY ./docker/second_lesson/entry_point2.sh /entry_point2.sh

# Даем права на выполнение
RUN chmod +x /entry_point2.sh

# Указываем точку входа
ENTRYPOINT ["/entry_point2.sh"]

# Команда по умолчанию, если в docker-compose не указана другая
CMD ["bash"]